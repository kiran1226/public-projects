# Copy to .env and add your key. .env is git-ignored.
# Get a key at https://console.anthropic.com/ (the projects run without one in replay/baseline mode).
ANTHROPIC_API_KEY=
# Optional: NVIDIA API catalog key for the NVIDIA-hosted configuration (https://build.nvidia.com/).
NVIDIA_API_KEY=
# Optional: a GitHub token for projects/issue-triage-desk. It only raises GitHub's read limits;
# the project works without one.
GITHUB_TOKEN=
